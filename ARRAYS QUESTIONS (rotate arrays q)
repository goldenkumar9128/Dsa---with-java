
class Solution {
    public void rotateArr(int arr[], int d) {
        // code here
        int n = arr.length;
        d%=n;
        revers(arr,0,d-1);
        revers(arr,d,n-1);
        revers(arr,0,n-1);
        
    }
    public void revers(int arr[], int i, int j){
        while(i<j){
            int temp=arr[i];
            arr[i]=arr[j];
            arr[j]=temp;
            i++;
            j--;
        }
    } 
}
